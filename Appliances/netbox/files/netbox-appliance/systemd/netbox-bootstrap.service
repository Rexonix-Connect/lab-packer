[Unit]
Description=NetBox appliance first-boot bootstrap
Documentation=https://github.com/Rexonix-Connect/lab-packer
# ovf-settings.service (from the hardened base) applies the deploy form's
# network and identity before networking starts, and cloud-init sets the host
# name and creates users in its init stage, which completes before
# network-online.target - so by this point the guest knows who it is.
#
# Never order this unit after a cloud-init unit that runs late in boot,
# cloud-final.service in particular. This unit is pulled into
# multi-user.target, cloud-final.service is ordered after multi-user.target,
# and the resulting cycle is not an error systemd reports as a failure: it
# breaks it by DELETING jobs. It deleted this unit's start job (so the
# bootstrap never ran, and nginx/netbox/netbox-rq went with it, since they
# Requires= it) and cloud-final's (so cloud-init never finished and the deploy
# form's user-data was never applied). The appliance booted in 13 seconds,
# logged nothing against any of them, and served nothing.
After=ovf-settings.service network-online.target postgresql.service redis-server.service
Wants=network-online.target
# NetBox, its virtual environment and its database all live here.
RequiresMountsFor=/srv/netbox
Before=netbox.service netbox-rq.service nginx.service
ConditionPathExists=!/var/lib/netbox-appliance/bootstrapped

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/netbox-firstboot.py
# Migrations against an external database can take a while on a slow link.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
