#!/bin/bash
# One-screen health summary for the appliance. Also drives the MOTD, so it has
# to stay quick, quiet and safe to run as any account.
set -uo pipefail

STATE_DIR=/var/lib/netbox-appliance
STATE="${STATE_DIR}/state.json"
UNITS=(netbox netbox-rq nginx postgresql redis-server)

field() {
	python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))
except Exception:
    print("")' "${STATE}" "${1}" 2>/dev/null
}

if [ ! -f "${STATE_DIR}/bootstrapped" ]; then
	if [ -f "${STATE_DIR}/failed" ]; then
		echo "NetBox appliance: BOOTSTRAP FAILED"
		echo "  journalctl -u netbox-bootstrap -b   (details in ${STATE_DIR}/failed)"
		echo "  retry: systemctl start netbox-bootstrap"
	elif [ "$(systemctl is-system-running 2>/dev/null || true)" != 'initializing' ] &&
		[ "$(systemctl is-system-running 2>/dev/null || true)" != 'starting' ] &&
		[ "$(systemctl is-active netbox-bootstrap 2>/dev/null || true)" = 'inactive' ]; then
		# Boot is over, the unit is not running and never finished. It was not
		# skipped either - its condition holds while this marker is missing. So
		# its start job was dropped before it ran, which is what systemd does to
		# break an ordering cycle, silently as far as the unit is concerned.
		echo "NetBox appliance: BOOTSTRAP NEVER RAN"
		echo "  Boot has finished but netbox-bootstrap is inactive, so its start"
		echo "  job was dropped rather than executed. Check for a dependency cycle:"
		echo "    journalctl -b | grep -i 'ordering cycle'"
		echo "  Start it by hand with: systemctl start netbox-bootstrap"
	else
		echo "NetBox appliance: bootstrapping, not ready yet"
		echo "  journalctl -u netbox-bootstrap -bf"
	fi
	exit 0
fi

echo "NetBox appliance $(field netbox_version)"
echo "  URL       $(field url)"
echo "  Database  $(field database)"
echo "  Metrics   $(if [ "$(field metrics_enabled)" = 'True' ]; then echo enabled; else echo off; fi)"
echo "  TLS       $(if [ "$(field self_signed_certificate)" = 'True' ]; then echo 'self-signed (replace via the deploy form)'; else echo 'operator-supplied'; fi)"

printf '  Services '
unhealthy=0
for unit in "${UNITS[@]}"; do
	state="$(systemctl is-active "${unit}" 2>/dev/null || true)"
	printf '%s=%s ' "${unit}" "${state}"
	[ "${state}" = 'active' ] || unhealthy=1
done
printf '\n'

# Unit states answer "did systemd start it"; this answers the question that
# actually matters. They can disagree - a deployment once came up with nginx
# active, NetBox inactive and a bootstrap that reported success, and nothing on
# the appliance said it was not serving.
code="$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' https://127.0.0.1/login/ 2>/dev/null || true)"
if [ "${code}" = '200' ]; then
	echo "  Serving   yes (HTTP 200)"
else
	echo "  Serving   NO (HTTP ${code:-000}) - journalctl -u netbox-bootstrap -b"
	unhealthy=1
fi

# Patch reality, not patch intent. unattended-upgrades is enabled in the image,
# but at a customer site it may have no route to the archive - directly, or
# through a proxy nobody told the appliance about. That failure is otherwise
# completely silent: the timer runs, finds nothing, and the appliance looks
# healthy while patching nothing for months. All three checks read local state
# only, because this drives the MOTD and must not block on the network.
stamp=/var/lib/apt/periodic/update-success-stamp
if [ -f "${stamp}" ]; then
	age_days=$(( ( $(date +%s) - $(date -r "${stamp}" +%s) ) / 86400 ))
	if [ "${age_days}" -le 2 ]; then
		reach="archive reachable"
	else
		reach="LAST REACHED THE ARCHIVE ${age_days} DAYS AGO - check egress/proxy"
		unhealthy=1
	fi
else
	reach="NEVER REACHED THE ARCHIVE - check egress/proxy"
	unhealthy=1
fi

# apt-check reads the local apt cache and prints "updates;security".
security=''
if [ -x /usr/lib/update-notifier/apt-check ]; then
	counts="$(/usr/lib/update-notifier/apt-check 2>&1 || true)"
	case "${counts}" in
	*';'*) security="${counts#*;}" ;;
	esac
fi
if [ -n "${security}" ] && [ "${security}" != '0' ]; then
	echo "  Updates   ${security} security update(s) pending (${reach})"
else
	echo "  Updates   none pending (${reach})"
fi

if [ -f /var/run/reboot-required ]; then
	echo "  Reboot    REQUIRED to finish applying updates (kernel or libraries)"
	unhealthy=1
fi

latest="$(ls -1t /srv/netbox/backups/*.dump 2>/dev/null | head -n 1 || true)"
if [ -n "${latest}" ]; then
	echo "  Backup    $(basename "${latest}") ($(date -r "${latest}" '+%Y-%m-%d %H:%M'))"
else
	echo "  Backup    none yet (nightly timer: $(systemctl is-active netbox-backup.timer 2>/dev/null || echo unknown))"
fi

if [ -f /root/netbox-credentials.txt ]; then
	echo "  Login     generated credentials in /root/netbox-credentials.txt (netbox-credentials)"
fi

exit "${unhealthy}"
