#!/bin/bash
# Move a deployed appliance to another NetBox release, or reinstall the
# current one after editing local_requirements.txt.
#
# A backup is taken first, unconditionally: upgrade.sh applies migrations, and
# NetBox migrations are not reversible. The template itself is not upgraded by
# this - rebuild the image with a new netbox_version input for that.
set -euo pipefail

NETBOX_ROOT=/opt/netbox

if [ "$(id -u)" -ne 0 ]; then
	echo "netbox-upgrade: run as root (installs into the virtual environment and restarts services)" >&2
	echo "  try: sudo netbox-upgrade $*" >&2
	exit 1
fi

usage() {
	echo "usage: netbox-upgrade <vX.Y.Z> | --reinstall [--yes]"
	echo
	echo "  vX.Y.Z       check out that NetBox release tag and upgrade"
	echo "  --reinstall  rebuild the virtual environment at the current tag,"
	echo "               picking up changes to local_requirements.txt"
	echo
	echo "Current release: $(git -C "${NETBOX_ROOT}" describe --tags --always 2>/dev/null || echo unknown)"
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
'')
	usage >&2
	exit 2
	;;
esac

current="$(git -C "${NETBOX_ROOT}" describe --tags --always)"
target="${1}"
assume_yes="${2:-}"

if [ "${target}" != '--reinstall' ]; then
	case "${target}" in
	v[0-9]*.[0-9]*.[0-9]*) ;;
	*)
		echo "netbox-upgrade: '${target}' is not a release tag such as v4.6.7" >&2
		exit 2
		;;
	esac
	echo "netbox-upgrade: fetching release tags ..."
	git -C "${NETBOX_ROOT}" fetch --tags --quiet
	if ! git -C "${NETBOX_ROOT}" rev-parse --verify --quiet "refs/tags/${target}" >/dev/null; then
		echo "netbox-upgrade: no such release tag: ${target}" >&2
		exit 1
	fi
	echo "netbox-upgrade: ${current} -> ${target}"
else
	echo "netbox-upgrade: reinstalling ${current}"
fi

if [ "${assume_yes}" != '--yes' ]; then
	read -r -p "Continue? [y/N] " answer
	case "${answer}" in
	y | Y | yes | YES) ;;
	*)
		echo "Aborted."
		exit 1
		;;
	esac
fi

echo "netbox-upgrade: taking a backup first ..."
netbox-backup

if [ "${target}" != '--reinstall' ]; then
	git -C "${NETBOX_ROOT}" checkout --quiet "tags/${target}"
fi

# --- requirements-workaround begin ---
# Upstream dependency drift, and the pin that works around it, kept in step
# with the release about to be installed. NetBox 4.6 pins mkdocstrings 1.0.6,
# whose documentation build broke with pymdown-extensions 12.2
# (netbox-community/netbox#23376); the 4.6 line ended without the fix, so the
# image build pins mkdocstrings 1.0.7 in local_requirements.txt, which
# upgrade.sh installs on top of requirements.txt (install-netbox.sh, same tag,
# same condition - keep them identical). A release that pins mkdocstrings
# itself to something newer - 4.7.4 pins 1.0.8 - would be downgraded by that
# same line, so it is removed for those. The operator's own lines are never
# touched. Lifted out by tests/test_upgrade_workaround.sh, by these markers.
WORKAROUND_TAG='lab-packer workaround: netbox-community/netbox#23376'
WORKAROUND_LINE="mkdocstrings==1.0.7  # ${WORKAROUND_TAG}"
workaround_removed=0
reconcile_requirements_workarounds() {
	local requirements="${NETBOX_ROOT}/local_requirements.txt"
	local kept
	if grep -qE '^mkdocstrings==1\.0\.6[[:space:]]*$' "${NETBOX_ROOT}/requirements.txt"; then
		if ! grep -qF -- "${WORKAROUND_TAG}" "${requirements}" 2>/dev/null; then
			echo "netbox-upgrade: this release pins mkdocstrings 1.0.6, whose documentation build is broken upstream;"
			echo "  pinning 1.0.7 in local_requirements.txt (netbox-community/netbox#23376)"
			printf '%s\n' "${WORKAROUND_LINE}" >>"${requirements}"
		fi
	elif grep -qF -- "${WORKAROUND_TAG}" "${requirements}" 2>/dev/null; then
		echo "netbox-upgrade: this release pins mkdocstrings itself; dropping the 1.0.7 workaround from local_requirements.txt"
		kept="$(grep -vF -- "${WORKAROUND_TAG}" "${requirements}" || true)"
		# Written back in place rather than moved over, so the file keeps its
		# owner and mode. An empty result stays an empty file, not a blank line.
		if [ -n "${kept}" ]; then
			printf '%s\n' "${kept}" >"${requirements}"
		else
			: >"${requirements}"
		fi
		workaround_removed=1
	fi
}
# --- requirements-workaround end ---
reconcile_requirements_workarounds

rollback_hint() {
	echo "Roll back with:"
	echo "    git -C ${NETBOX_ROOT} checkout tags/${current} && ${NETBOX_ROOT}/upgrade.sh"
	echo "    netbox-restore <the backup taken above>"
	if [ "${workaround_removed}" -eq 1 ]; then
		echo "  ${current} needs the mkdocstrings pin that was just dropped from local_requirements.txt,"
		echo "  or its upgrade.sh fails in the documentation build; put it back first:"
		echo "    printf '%s\\n' '${WORKAROUND_LINE}' >>${NETBOX_ROOT}/local_requirements.txt"
	fi
}

echo "netbox-upgrade: running upgrade.sh ..."
if ! "${NETBOX_ROOT}/upgrade.sh"; then
	echo "netbox-upgrade: upgrade.sh failed." >&2
	rollback_hint >&2
	exit 1
fi

echo "netbox-upgrade: restarting services ..."
systemctl restart netbox.service netbox-rq.service
systemctl reload nginx.service

echo "netbox-upgrade: checking the appliance answers ..."
for _ in $(seq 1 30); do
	code="$(curl -sk -o /dev/null -w '%{http_code}' https://127.0.0.1/login/ || true)"
	[ "${code}" = '200' ] && break
	sleep 5
done
if [ "${code:-}" != '200' ]; then
	echo "netbox-upgrade: NetBox did not come back (last HTTP status ${code:-none})." >&2
	rollback_hint >&2
	exit 1
fi

netbox-status
echo "netbox-upgrade: now running $(git -C "${NETBOX_ROOT}" describe --tags --always)"
rollback_hint
