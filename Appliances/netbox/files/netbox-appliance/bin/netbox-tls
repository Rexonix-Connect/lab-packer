#!/bin/bash
# Show or replace the TLS certificate nginx serves.
#
# The deploy form's netbox.tls-cert and netbox.tls-key are read once, by the
# first-boot bootstrap, and there is no second first boot. A certificate that
# arrives later - a real one replacing the generated self-signed pair, a
# wildcard for the domain, a renewal - has to be installed here.
#
#   netbox-tls show
#   netbox-tls install fullchain.pem privkey.pem
set -euo pipefail

CERT=/etc/netbox/tls/netbox.crt
KEY=/etc/netbox/tls/netbox.key
# Written by netbox-firstboot.py whenever it generates a certificate, holding
# the SAN list it generated for. netbox-reconcile reissues the certificate on
# any boot where that list no longer matches the appliance's names - which
# would quietly overwrite an operator's certificate - so installing one
# removes the marker, and that is also what turns HSTS on.
SELF_SIGNED=/etc/netbox/tls/.self-signed
STATE=/var/lib/netbox-appliance/state.json

usage() {
	cat <<'EOF'
usage: netbox-tls show
       netbox-tls install <certificate.pem> <key.pem>

  show      what is installed, what it covers, when it expires
  install   replace it with an operator-supplied pair

The certificate file must be the full chain, leaf first. nginx serves the file
as given: a chain in the wrong order works in whichever browser happens to
have the intermediate cached and fails everywhere else.
EOF
}

if [ "$(id -u)" -ne 0 ]; then
	echo "netbox-tls: run as root (it writes the private key nginx reads)" >&2
	echo "  try: sudo netbox-tls $*" >&2
	exit 1
fi

die() {
	echo "netbox-tls: ${1}" >&2
	exit 1
}

served_name() {
	python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("fqdn", ""))
except Exception:
    print("")' "${STATE}" 2>/dev/null || true
}

summarize() {
	openssl x509 -in "${1}" -noout -subject -issuer -startdate -enddate |
		sed 's/^/    /'
	local sans
	sans="$(openssl x509 -in "${1}" -noout -ext subjectAltName 2>/dev/null |
		tail -n +2 | tr -d ' \n' || true)"
	[ -n "${sans}" ] && echo "    subjectAltName=${sans}"
	return 0
}

# Wildcard-aware, and SAN only: a name that appears solely in the Subject CN
# has not been accepted by any current browser for years, so matching on it
# here would report coverage the operator does not actually have.
covers() {
	openssl x509 -in "${1}" -noout -ext subjectAltName 2>/dev/null |
		python3 -c '
import re
import sys

name = sys.argv[1].lower().rstrip(".")
for candidate in re.findall(r"DNS:([^,\s]+)", sys.stdin.read()):
    candidate = candidate.lower().rstrip(".")
    if candidate == name:
        raise SystemExit(0)
    if candidate.startswith("*."):
        suffix = candidate[1:]
        if name.endswith(suffix) and "." not in name[:-len(suffix)]:
            raise SystemExit(0)
raise SystemExit(1)' "${2}"
}

case "${1:-}" in
show)
	[ -f "${CERT}" ] || die "no certificate at ${CERT}"
	if [ -f "${SELF_SIGNED}" ]; then
		echo "  Source    generated by the appliance (self-signed), reissued when its names change"
	else
		echo "  Source    operator-supplied; the appliance will not touch it"
	fi
	summarize "${CERT}"
	name="$(served_name)"
	if [ -n "${name}" ]; then
		if covers "${CERT}" "${name}"; then
			echo "    covers ${name}: yes"
		else
			echo "    covers ${name}: NO - browsers will refuse this certificate for that name"
		fi
	fi
	if ! openssl x509 -in "${CERT}" -noout -checkend 0 >/dev/null; then
		echo "    EXPIRED"
	elif ! openssl x509 -in "${CERT}" -noout -checkend 2592000 >/dev/null; then
		echo "    expires within 30 days"
	fi
	;;
install)
	certificate="${2:-}"
	private_key="${3:-}"
	[ -n "${certificate}" ] && [ -n "${private_key}" ] || {
		usage >&2
		exit 2
	}
	[ -r "${certificate}" ] || die "cannot read ${certificate}"
	[ -r "${private_key}" ] || die "cannot read ${private_key}"

	openssl x509 -in "${certificate}" -noout >/dev/null 2>&1 ||
		die "${certificate} is not a PEM certificate"
	openssl pkey -in "${private_key}" -noout >/dev/null 2>&1 ||
		die "${private_key} is not a PEM private key (decrypt an encrypted key first)"

	# openssl reads only the first certificate in the file, so this doubles as
	# the leaf-first check: a chain the wrong way round fails here.
	cert_public="$(openssl x509 -in "${certificate}" -noout -pubkey)"
	key_public="$(openssl pkey -in "${private_key}" -pubout)"
	[ "${cert_public}" = "${key_public}" ] ||
		die "the key does not match the first certificate in ${certificate};"$'\n'"  either they are not a pair, or the chain is not leaf-first"

	openssl x509 -in "${certificate}" -noout -checkend 0 >/dev/null ||
		die "${certificate} has already expired"
	openssl x509 -in "${certificate}" -noout -checkend 2592000 >/dev/null ||
		echo "netbox-tls: warning - this certificate expires within 30 days" >&2

	name="$(served_name)"
	if [ -n "${name}" ] && ! covers "${certificate}" "${name}"; then
		echo "netbox-tls: warning - no subjectAltName covers ${name}, which is" >&2
		echo "  the name this appliance serves. Browsers will refuse it there." >&2
		echo "  Change the name with the netbox.fqdn deploy-form property, or" >&2
		echo "  install a certificate that covers it." >&2
	fi

	# The outgoing pair is kept until nginx has accepted the new one: nginx
	# holds the old certificate until it reloads, and a configuration it
	# rejects must not leave the appliance with no way back.
	[ -f "${CERT}" ] && cp -a "${CERT}" "${CERT}.previous"
	[ -f "${KEY}" ] && cp -a "${KEY}" "${KEY}.previous"
	# The marker goes with them. Rolling back the pair but not the marker
	# would leave a generated certificate that the appliance no longer knows
	# is its own: it would stop reissuing it, and start sending HSTS for a
	# self-signed certificate - a browser warning nobody can click through.
	[ -f "${SELF_SIGNED}" ] && cp -a "${SELF_SIGNED}" "${SELF_SIGNED}.previous"

	install -m 0644 -o root -g root "${certificate}" "${CERT}"
	install -m 0640 -o root -g www-data "${private_key}" "${KEY}"
	rm -f "${SELF_SIGNED}"

	if ! nginx -t 2>&1 | sed 's/^/    /'; then
		[ -f "${CERT}.previous" ] && mv "${CERT}.previous" "${CERT}"
		[ -f "${KEY}.previous" ] && mv "${KEY}.previous" "${KEY}"
		[ -f "${SELF_SIGNED}.previous" ] && mv "${SELF_SIGNED}.previous" "${SELF_SIGNED}"
		die "nginx rejected the new certificate; the previous one is back in place"
	fi

	# Rewrites the nginx snippets from the marker's absence - which is what
	# sends HSTS - and refreshes the TLS line netbox-status reports. Restart,
	# not start: the unit is RemainAfterExit=yes and start would do nothing.
	systemctl restart netbox-reconcile.service
	systemctl reload nginx.service

	rm -f "${CERT}.previous" "${KEY}.previous" "${SELF_SIGNED}.previous"

	code="$(curl -sk --max-time 10 -o /dev/null -w '%{http_code}' \
		https://127.0.0.1/login/ 2>/dev/null || true)"
	if [ "${code}" != '200' ]; then
		echo "netbox-tls: warning - the appliance answered HTTP ${code:-000} after" >&2
		echo "  the reload; check 'netbox-status' and 'journalctl -u nginx -b'." >&2
	fi

	echo "netbox-tls: installed. HSTS is now sent, and the appliance will not"
	echo "  reissue this certificate."
	summarize "${CERT}"
	;;
-h | --help)
	usage
	;;
'')
	usage >&2
	exit 2
	;;
*)
	usage >&2
	exit 2
	;;
esac
