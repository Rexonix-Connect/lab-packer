#!/bin/bash
# Show or remove the credentials the first-boot bootstrap generated.
#
# A generated admin password is written to /root/netbox-credentials.txt and,
# because a freshly deployed appliance may have no other way in, echoed on the
# local console through /etc/issue.d. Clear both once you have logged in and
# changed the password.
set -euo pipefail

CREDENTIALS=/root/netbox-credentials.txt
ISSUE=/etc/issue.d/60-netbox.issue

usage() {
	echo "usage: netbox-credentials [--clear]"
	echo
	echo "  (no options)  print the generated credentials"
	echo "  --clear       remove the credentials file and the console banner"
}

case "${1:-}" in
'')
	if [ ! -f "${CREDENTIALS}" ]; then
		echo "No generated credentials on this appliance." >&2
		echo "Either they were already cleared, or the admin password came" >&2
		echo "from the deploy form. Reset it with:" >&2
		echo "    netbox-manage changepassword <username>" >&2
		exit 1
	fi
	cat "${CREDENTIALS}"
	;;
--clear)
	rm -f "${CREDENTIALS}" "${ISSUE}"
	echo "Removed the credentials file and the console banner."
	;;
-h | --help)
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
