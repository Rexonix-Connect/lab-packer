#!/bin/bash
# Restore an appliance from a netbox-backup pair.
#
# Both halves are restored: the database dump and the file archive, which
# carries /etc/netbox/appliance.json. The configuration has to come back too -
# it holds SECRET_KEY and the API token pepper, without which the restored
# database's API tokens and sessions cannot be validated. The current
# configuration is kept alongside as .pre-restore in case the backup came from
# a differently addressed appliance.
set -euo pipefail

BACKUP_DIR=/srv/netbox/backups
CONFIG="${NETBOX_APPLIANCE_CONFIG:-/etc/netbox/appliance.json}"
# The physical path, as netbox-backup uses: /opt/netbox is a symlink to
# /srv/netbox, the archive stores physical paths, and upgrade.sh resolves the
# symlink when it records the virtual environment location.
NETBOX_ROOT="${NETBOX_APPLIANCE_ROOT:-$(readlink -f /opt/netbox)}"

if [ "$(id -u)" -ne 0 ]; then
	echo "netbox-restore: run as root (stops services and replaces the database)" >&2
	echo "  try: sudo netbox-restore $*" >&2
	exit 1
fi

usage() {
	echo "usage: netbox-restore <timestamp|dump-file> [--yes]"
	echo
	echo "Available backups:"
	ls -1 "${BACKUP_DIR}"/netbox-*.dump 2>/dev/null |
		sed 's#.*/netbox-##; s#\.dump$#  #' || echo "  (none)"
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
'')
	usage >&2
	exit 2
	;;
esac

target="${1}"
assume_yes="${2:-}"
if [ -f "${target}" ]; then
	dump="${target}"
	stamp="$(basename "${dump}" .dump)"
	stamp="${stamp#netbox-}"
else
	stamp="${target}"
	dump="${BACKUP_DIR}/netbox-${stamp}.dump"
fi
files="${BACKUP_DIR}/netbox-${stamp}.files.tar.gz"

[ -f "${dump}" ] || {
	echo "netbox-restore: ${dump} does not exist" >&2
	exit 1
}

echo "About to restore ${stamp}. This REPLACES the current NetBox database"
echo "and the media, scripts, reports and configuration on this appliance."
if [ "${assume_yes}" != '--yes' ]; then
	read -r -p "Type 'restore' to continue: " answer
	[ "${answer}" = 'restore' ] || {
		echo "Aborted."
		exit 1
	}
fi

echo "netbox-restore: stopping services ..."
systemctl stop netbox.service netbox-rq.service

if [ -f "${files}" ]; then
	echo "netbox-restore: restoring files ..."
	[ -f "${CONFIG}" ] && cp -a "${CONFIG}" "${CONFIG}.pre-restore"
	tar --extract --gzip --file="${files}" --directory=/
	chown root:netbox "${CONFIG}"
	chmod 0640 "${CONFIG}"
else
	echo "netbox-restore: no file archive for ${stamp}; restoring the database only"
fi

# Plugins, before the database and before anything imports the configuration.
#
# The archive restores local_requirements.txt and appliance.json - so PLUGINS
# comes back - but the plugin packages themselves live in the virtual
# environment, which on a freshly deployed appliance does not have them. NetBox
# refuses to start, and even `manage.py migrate` refuses to run, when a plugin
# named in PLUGINS cannot be imported. Restoring into a new appliance is the
# supported way to move to a new image or a new NetBox major version, so this
# is exactly the path that has to work.
#
# It happens before pg_restore on purpose: a missing plugin then fails with the
# database untouched, rather than half-restored and unable to start.
if [ -s "${NETBOX_ROOT}/local_requirements.txt" ]; then
	echo "netbox-restore: installing plugin packages from local_requirements.txt ..."
	if ! "${NETBOX_ROOT}/venv/bin/pip" install --quiet \
		-r "${NETBOX_ROOT}/local_requirements.txt"; then
		echo "netbox-restore: could not install the backup's plugin packages." >&2
		echo "  The database has NOT been touched." >&2
		echo "  This appliance may have no route to PyPI - check 'netbox-status'." >&2
		echo "  Either give it one, or deploy an image with these plugins baked in:" >&2
		sed 's/^/    /' "${NETBOX_ROOT}/local_requirements.txt" >&2
		exit 1
	fi
fi

# Verify rather than assume: local_requirements.txt is the pip name, PLUGINS is
# the Python module name, and they routinely differ (netbox-bgp / netbox_bgp).
# A backup whose PLUGINS lists something local_requirements.txt does not
# install would otherwise fail later, with the database already replaced.
python3 - "${CONFIG}" "${NETBOX_ROOT}" <<'PY' || exit 1
import json
import os
import subprocess
import sys

config, root = sys.argv[1], sys.argv[2]
with open(config) as handle:
    plugins = json.load(handle).get("plugins", [])
if not plugins:
    raise SystemExit(0)

# Imported the way NetBox will import them: from the project directory, with
# Django configured. NetBox is not a pip package - it is only importable from
# ${root}/netbox - so a bare `python -c "import <module>"` fails for every
# plugin whose __init__ imports netbox.plugins without a fallback, which is
# most of them. That check called healthy plugins missing and refused to
# restore backups that would have restored perfectly.
PROBE = """
import sys

import django

django.setup()

missing = []
for name in sys.argv[1:]:
    try:
        __import__(name)
    except Exception as exc:
        missing.append("%s (%s)" % (name, exc))
print("\\n".join(missing))
"""

environment = dict(os.environ, DJANGO_SETTINGS_MODULE="netbox.settings")
probe = subprocess.run([root + "/venv/bin/python", "-c", PROBE] + plugins,
                       cwd=root + "/netbox", env=environment,
                       capture_output=True, text=True)
if probe.returncode != 0:
    # django.setup() itself failed - which it does when an enabled plugin
    # cannot be imported at all, so report it rather than guessing.
    sys.stderr.write("netbox-restore: NetBox could not start with the "
                     "backup's plugins:\n")
    sys.stderr.write((probe.stderr or probe.stdout).strip() + "\n")
    sys.stderr.write("  The database has NOT been touched.\n")
    raise SystemExit(1)
missing = [line for line in probe.stdout.splitlines() if line.strip()]

if missing:
    sys.stderr.write(
        "netbox-restore: the backup enables plugins this appliance cannot "
        "import: %s\n" % ", ".join(missing))
    sys.stderr.write("  The database has NOT been touched.\n")
    sys.stderr.write("  Add them to %s/local_requirements.txt and re-run, or\n"
                     "  remove them from 'plugins' in %s.\n" % (root, config))
    raise SystemExit(1)
print("netbox-restore: %d plugin(s) present: %s"
      % (len(plugins), ", ".join(plugins)))
PY

echo "netbox-restore: restoring the database ..."
eval "$(python3 - "${CONFIG}" <<'PY'
import json
import shlex
import sys

with open(sys.argv[1]) as handle:
    database = json.load(handle)["database"]

def export(name, value):
    print("export %s=%s" % (name, shlex.quote(str(value))))

export("PGDATABASE", database.get("NAME", "netbox"))
export("PGUSER", database.get("USER", "netbox"))
if database.get("HOST"):
    export("PGHOST", database["HOST"])
if database.get("PORT"):
    export("PGPORT", database["PORT"])
if database.get("PASSWORD"):
    export("PGPASSWORD", database["PASSWORD"])
PY
)"

if [ -n "${PGHOST:-}" ]; then
	pg_restore --clean --if-exists --no-owner --no-privileges \
		--dbname="${PGDATABASE}" "${dump}"
else
	runuser -u netbox -- env PGDATABASE="${PGDATABASE}" PGUSER="${PGUSER}" \
		pg_restore --clean --if-exists --no-owner --no-privileges \
		--dbname="${PGDATABASE}" <"${dump}"
fi

echo "netbox-restore: applying any migrations the image is ahead of ..."
netbox-manage migrate --no-input

echo "netbox-restore: starting services ..."
systemctl start netbox.service netbox-rq.service
systemctl reload nginx.service

netbox-status
