#!/bin/bash
# Print or clear the credentials generated at first boot.
#
#   diode-credentials
#   diode-credentials --clear
#
# --clear removes /root/diode-credentials.txt and the console banner. Do it
# once the OAuth2 client secrets are stored somewhere an operator can find
# them again - unlike a password, they cannot be reset without re-issuing the
# client and reconfiguring whatever authenticates with it.
#
# TODO(scaffold): implement, following netbox-credentials.
set -euo pipefail

CREDENTIALS=/root/diode-credentials.txt
ISSUE=/etc/issue.d/60-diode.issue

if [ "$(id -u)" -ne 0 ]; then
	echo "diode-credentials: run as root (the file is 0600)" >&2
	echo "  try: sudo diode-credentials $*" >&2
	exit 1
fi

case "${1:-show}" in
show)
	if [ -r "${CREDENTIALS}" ]; then
		cat "${CREDENTIALS}"
	else
		echo "diode-credentials: none present (already cleared?)"
	fi
	;;
--clear)
	rm -f "${CREDENTIALS}" "${ISSUE}"
	echo "diode-credentials: cleared"
	;;
*)
	echo "usage: diode-credentials [--clear]" >&2
	exit 2
	;;
esac
