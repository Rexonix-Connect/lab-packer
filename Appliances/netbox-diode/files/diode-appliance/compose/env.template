# Environment for the Diode compose project.
#
# This file is the TEMPLATE that ships in the image. diode-firstboot.py reads
# it, substitutes every placeholder and writes the result to
# /etc/diode/compose/.env with mode 0600. The template itself carries no
# secret, which is what lets the template be exported: like the NetBox
# appliance, this image contains no identity and no credential.
#
# Derived from netboxlabs/diode: diode-server/docker/sample.env. Re-vendor it
# alongside docker-compose.yaml whenever diodeVersion moves - upstream adds
# settings between releases, and a variable the compose file references but
# this file does not set makes every container start with it empty.

PROJECT_NAME=diode

# --- Image pins -------------------------------------------------------------
# Every tag is explicit; none may be "latest". install-diode.sh pulls each one
# at build time and records the resolved digest in /etc/diode/images.lock, so
# what a deployed appliance runs is the image the build tested, not whatever
# the tag points at later. diode-upgrade rewrites these.
DIODE_TAG=__DIODE_TAG__
DIODE_INGRESS_IMAGE=nginx:1.27-alpine
DIODE_REDIS_IMAGE=redis/redis-stack-server:7.4.0-v1
DIODE_POSTGRES_IMAGE=docker.io/postgres:16-alpine
DIODE_HYDRA_IMAGE=oryd/hydra:v2.2.0

# --- Ingress ----------------------------------------------------------------
# Published on 127.0.0.1 only; host nginx is what the network reaches.
DIODE_NGINX_PORT=8080

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_USERNAME=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DIODE_POSTGRES_DB_NAME=diode
DIODE_POSTGRES_USER=diode
DIODE_POSTGRES_PASSWORD=__DIODE_POSTGRES_PASSWORD__
HYDRA_POSTGRES_DB_NAME=hydra
HYDRA_POSTGRES_USER=hydra
HYDRA_POSTGRES_PASSWORD=__HYDRA_POSTGRES_PASSWORD__
MIGRATION_ENABLED=true

# --- OAuth2 (Ory Hydra) -----------------------------------------------------
HYDRA_STRATEGIES_ACCESS_TOKEN=jwt
HYDRA_STRATEGIES_REFRESH_TOKEN=jwt
HYDRA_STRATEGIES_JWT_SCOPE_CLAIM=both
HYDRA_TTL_ACCESS_TOKEN=1h
HYDRA_OIDC_SUBJECT_IDENTIFIERS_SUPPORTED_TYPES=public
HYDRA_URLS_SELF_ISSUER=http://127.0.0.1:4444
HYDRA_SECRETS_SYSTEM_0=__HYDRA_SYSTEM_SECRET__
AUTH_HTTP_PORT=8080
OAUTH2_PUBLIC_SERVER_URL=http://hydra:4444
OAUTH2_ADMIN_SERVER_URL=http://hydra:4445
DIODE_AUTH_TOKEN_URL=http://diode-auth:8080/token

# --- Target NetBox ----------------------------------------------------------
# Set from the diode.netbox-url deploy-form property. The reconciler
# authenticates to the NetBox Diode plugin with these OAuth2 client
# credentials, not with a NetBox API token - the plugin validates the token
# Hydra issued.
NETBOX_DIODE_PLUGIN_API_BASE_URL=__NETBOX_PLUGIN_API_BASE_URL__
NETBOX_DIODE_PLUGIN_API_TIMEOUT_SECONDS=30
NETBOX_DIODE_PLUGIN_SKIP_TLS_VERIFY=__NETBOX_SKIP_TLS_VERIFY__
# /certs/ca.pem when the deploy form supplied a CA bundle, empty otherwise.
# Go ignores an empty value and uses the system trust store, so this must not
# be set to a path that holds an empty file.
SSL_CERT_FILE=__SSL_CERT_FILE__
DIODE_TO_NETBOX_CLIENT_ID=diode-to-netbox
DIODE_TO_NETBOX_CLIENT_SECRET=__DIODE_TO_NETBOX_CLIENT_SECRET__
DIODE_TO_NETBOX_RATE_LIMITER_RPS=20
DIODE_TO_NETBOX_RATE_LIMITER_BURST=1

# --- Ingestion tuning -------------------------------------------------------
INGESTION_LOG_PROCESSOR_BATCH_SIZE=50
INGESTION_LOG_PROCESSOR_CONCURRENCY=1
AUTO_APPLY_PROCESSOR_BATCH_SIZE=50
AUTO_APPLY_PROCESSOR_CONCURRENCY=1
ENABLE_GRAPH_DB=false

# --- Telemetry --------------------------------------------------------------
# Traces off, and no Sentry DSN: an appliance at a customer site must not
# phone home by default.
LOGGING_LEVEL=INFO
SENTRY_DSN=
TELEMETRY_ENVIRONMENT=appliance
TELEMETRY_METRICS_EXPORTER=prometheus
TELEMETRY_TRACES_EXPORTER=none
