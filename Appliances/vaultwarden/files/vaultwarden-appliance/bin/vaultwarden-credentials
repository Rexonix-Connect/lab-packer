#!/bin/bash
# Show or remove the admin token the first-boot bootstrap generated.
#
# Only its argon2id hash is used by Vaultwarden; the plaintext exists once, in
# /root/vaultwarden-credentials.txt and on the local console banner, so the
# operator can store it. Clear both once it is in your break-glass store.
set -euo pipefail

CREDENTIALS=/root/vaultwarden-credentials.txt
ISSUE=/etc/issue.d/60-vaultwarden.issue

if [ "$(id -u)" -ne 0 ]; then
	echo "vaultwarden-credentials: run as root (the credentials live in /root)" >&2
	echo "  try: sudo vaultwarden-credentials $*" >&2
	exit 1
fi

case "${1:-}" in
'')
	if [ ! -f "${CREDENTIALS}" ]; then
		echo "No generated credentials on this appliance." >&2
		echo "They were already cleared, or the token hash came from the deploy" >&2
		echo "form. Issue a new token with: vaultwarden-admin-token rotate" >&2
		exit 1
	fi
	cat "${CREDENTIALS}"
	;;
--clear)
	rm -f "${CREDENTIALS}" "${ISSUE}"
	echo "Removed the credentials file and the console banner."
	;;
-h | --help)
	echo "usage: vaultwarden-credentials [--clear]"
	;;
*)
	echo "usage: vaultwarden-credentials [--clear]" >&2
	exit 2
	;;
esac
