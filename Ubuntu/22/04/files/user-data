#cloud-config
autoinstall:
    version: 1
    early-commands:
        # Stop ssh for packer
        - sudo systemctl stop ssh
        # Best-effort stream raw installer logs to the active console.
        - >-
          sh -c 'echo "[autoinstall-debug] Streaming raw installer logs to /dev/console";
          exec tail -n 0 -F /var/log/installer/subiquity-server-debug.log /var/log/installer/curtin-install.log' >/dev/console 2>&1 &
    error-commands:
        - >-
          sh -c 'for log in /var/log/installer/subiquity*.log /var/log/installer/curtin-install.log; do
          if [ -f "$log" ]; then
          echo "[autoinstall-error] Last 200 lines of $log";
          tail -n 200 "$log";
          fi;
          done' >/dev/console 2>&1
    locale: en_US
    keyboard:
        layout: en
        variant: us
    identity:
        hostname: ubuntu-server
        username: vagrant
        password: '$6$rounds=4096$5CU3LEj/MQvbkfPb$LmKEF9pCfU8R.dA.GemgE/8GT6r9blge3grJvdsVTMFKyLEQwzEF3SGWqAzjawY/XHRpWj4fOiLBrRyxJhIRJ1'
    ssh:
        install-server: yes
        allow-pw: yes
    storage:
        layout:
            name: direct
            match:
                size: largest
    apt:
        primary:
            - arches: [i386, amd64]
              uri: "http://archive.ubuntu.com/ubuntu/"
    packages:
        - ca-certificates
        - curl
        - gnupg-agent
        - software-properties-common
        - ufw
        - unattended-upgrades
        - open-vm-tools
        - unzip
        - python3
        - python3-pip
        - cloud-guest-utils
    user-data:
        disable_root: true
        # Grow cloned VMs if their virtual disk is enlarged before first boot.
        growpart:
            mode: auto
            devices: ['/']
            ignore_growroot_disabled: false
        resize_rootfs: true
    late-commands:
        - sed -i -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/g' /target/etc/ssh/sshd_config
        - sed -i -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/g' /target/etc/ssh/sshd_config
        - echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/vagrant
        - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/vagrant
        # Mirror the long-running package operations to the VM console and a guest log file.
        - >-
          curtin in-target --target=/target -- bash -c '
          set -eo pipefail;
          log=/var/log/packer-autoinstall.log;
          if [ -w /dev/console ]; then
            exec > >(tee -a "$log" /dev/console) 2>&1;
          elif [ -w /dev/tty1 ]; then
            exec > >(tee -a "$log" /dev/tty1) 2>&1;
          else
            exec > >(tee -a "$log") 2>&1;
          fi;
          echo "[autoinstall] $(date -Iseconds) Starting package update/upgrade";
          echo "[autoinstall] writing package logs to $log";
          apt-get -o Dpkg::Use-Pty=0 update;
          echo "[autoinstall] $(date -Iseconds) Installing security upgrades";
          env DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Use-Pty=0 upgrade --yes;
          echo "[autoinstall] $(date -Iseconds) Installing base packages";
          env DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Use-Pty=0 install --yes kmod unattended-upgrades open-vm-tools;
          echo "[autoinstall] $(date -Iseconds) Package operations complete"'
        - >-
          curtin in-target --target=/target -- bash -c '
          version="$(dpkg-query -W -f="\$${Version}" kmod)";
          dpkg --compare-versions "$${version}" ge "${minimum_kmod_version}"'
        - printf 'install algif_aead /bin/false\nblacklist algif_aead\n' > /target/etc/modprobe.d/manual-disable-algif_aead.conf
        - curtin in-target --target=/target -- bash -c 'modprobe -n -v algif_aead | grep -q "/bin/false"'
